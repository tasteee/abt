{
	"name": "abt",
	"version": "4.0.0",
	"description": "CLI tool to list, select, and run npm scripts across a workspace.",
	"type": "module",
	"main": "./bin/index.js",
	"repository": "https://github.com/tasteee/abt",
	"author": "Rockie Colcleasure <shanecolcleasure@gmail.com>",
	"license": "MIT",
	"preferGlobal": true,
	"engines": {
		"node": "^18.19.0 || >=20.5.0"
	},
	"bin": {
		"abt": "./bin/index.js"
	},
	"files": [
		"bin"
	],
	"scripts": {
		"start": "node bin",
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"build-run": "npm run build && npm start",
		"prepublishOnly": "npm run build"
	},
	"devDependencies": {
		"@types/node": "^26.0.1",
		"prettier": "^1.11.1",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"execa": "^9.6.1",
		"pathenger": "^1.1.0",
		"picocolors": "^1.1.1"
	}
}
